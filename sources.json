{
  "mode": "controlled-auto-update",
  "controlled_sources": [
    {
      "id": "fmz200-exact-ad-domains",
      "url": "https://raw.githubusercontent.com/fmz200/wool_scripts/main/Shadowrocket/module/blockAds.srmodule",
      "allowed_repository": "fmz200/wool_scripts",
      "allowed_path": "Shadowrocket/module/blockAds.srmodule",
      "enabled": true,
      "max_source_lines": 12000,
      "min_exact_rules": 300,
      "max_exact_rules": 800,
      "min_safe_rules": 40,
      "max_safe_rules": 180,
      "note": "Never merge the whole module. Accept only exact DOMAIN,REJECT lines that pass all filters."
    }
  ],
  "pinned_scripts": [
    {
      "id": "app2smile-bilibili-json",
      "repository": "app2smile/rules",
      "branch": "master",
      "path": "js/bilibili-json.js",
      "max_bytes": 20000,
      "required_tokens": [
        "$response.body",
        "x/v2/feed/index",
        "$done"
      ]
    },
    {
      "id": "app2smile-bilibili-proto",
      "repository": "app2smile/rules",
      "branch": "master",
      "path": "js/bilibili-proto.js",
      "max_bytes": 180000,
      "required_tokens": [
        "$response.body",
        "Dynamic/DynAll",
        "View/View",
        "$done"
      ]
    },
    {
      "id": "zirawell-umetrip-ads",
      "repository": "zirawell/R-Store",
      "branch": "main",
      "path": "Res/Scripts/AntiAd/umetrip.js",
      "max_bytes": 10000,
      "required_tokens": [
        "$request.headers",
        "1000002",
        "1430064",
        "$done"
      ]
    }
  ],
  "local_scripts": [
    {
      "id": "local-baidupan-ads-only",
      "path": "scripts/baidupan_ads_only.js",
      "max_bytes": 10000,
      "required_tokens": [
        "splash_advertise_fetch_config_area",
        "business_ad_config_area",
        "$done"
      ]
    }
  ],
  "watch_only": [
    {
      "name": "app2smile QQ News",
      "url": "https://raw.githubusercontent.com/app2smile/rules/master/module/qqnews.sgmodule",
      "reason": "Script-only upstream; monitored but never auto-imported."
    },
    {
      "name": "app2smile Tieba",
      "url": "https://raw.githubusercontent.com/app2smile/rules/master/module/tieba.sgmodule",
      "reason": "Remote script and RULE-SET upstream; monitored but never auto-imported."
    },
    {
      "name": "ddgksf Weibo Ads",
      "url": "https://raw.githubusercontent.com/ddgksf2013/Rewrite/master/AdBlock/WeiboAds.conf",
      "reason": "Different format and rewrite logic; manual review required."
    }
  ],
  "safety": {
    "max_total_auto_rules": 200,
    "max_additions_per_run": 20,
    "max_removals_per_run": 20,
    "max_count_change_ratio": 0.25,
    "allow_bootstrap": false
  },
  "upstream_scripts": [
    {
      "id": "fmz200-taobao-script",
      "url": "https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/myBlockAds.js",
      "max_bytes": 100000,
      "note": "Monitor the upstream of the pinned Taobao script used by this module; never replace it automatically."
    }
  ],
  "sync_policy": {
    "min_inventory_ratio": 0.5,
    "exact_allowlist": [
      "iadmatapk.nosdn.127.net",
      "iadmusicmatvideo.music.126.net",
      "admusicpic.music.126.net",
      "ad.bn.netease.com",
      "bootrealtime.uve.weibo.com"
    ],
    "suffix_allowlist": [
      "erebor.douban.com",
      "ad.doubanio.com",
      "ad.10010.com"
    ],
    "reviewed_rewrites": [
      {
        "source": "fmz200-exact-ad-domains",
        "upstream": "^https?:\\/\\/frodo\\.douban\\.com\\/api\\/v2\\/movie\\/banner - reject",
        "publish": "^https?:\\/\\/frodo\\.douban\\.com\\/api\\/v\\d+\\/(?:app_ads\\/|erebor\\/feed_ad(?:\\/|\\?|$)|movie\\/(?:ad|banner)(?:\\/|\\?|$)) - reject-dict"
      },
      {
        "source": "fmz200-exact-ad-domains",
        "upstream": "^https?:\\/\\/img\\d\\.doubanio\\.com\\/view\\/dale-online\\/dale_ad\\/ - reject",
        "publish": "^https?:\\/\\/img\\d+\\.doubanio\\.com\\/view\\/dale-online\\/dale_ad\\/ - reject"
      }
    ],
    "note": "Publish all eligible reviewed changes together, without per-run or lifetime quantity quotas. Pause the whole batch only if additions exceed both 50 rules and 25% of existing active domain/interface rules. Unreviewed scripts, MITM and changed interfaces remain pending.",
    "unusual_additions_floor": 50,
    "unusual_growth_ratio": 0.25
  }
}
