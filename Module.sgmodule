#!name=广告屏蔽（稳定修正版）
#!desc=稳定模式 v6：仅拦截明确广告域名；无 MITM、无脚本、无 URL 重写，不影响普通联网与真实会员状态

# 设计原则：
# 1. 只使用精确 DOMAIN 规则，避免 DOMAIN-KEYWORD / 大范围 DOMAIN-SUFFIX 误伤。
# 2. 不拦截 HTTPDNS、CDN、统计 SDK 的共用基础设施。
# 3. 不解密 YouTube、微信、百度网盘流量，不修改会员响应。
# 4. 豆瓣只拦截自有广告主机，不拦截穿山甲/Pangle 全局域名。

[Rule]
# 豆瓣
DOMAIN,erebor.douban.com,REJECT,extended-matching,pre-matching
DOMAIN,ad.doubanio.com,REJECT,extended-matching,pre-matching

# 闲鱼 / 百度网盘开屏所使用的独立广告服务
DOMAIN,dsp.ads.umeng.com,REJECT,extended-matching,pre-matching
DOMAIN,api-v3.mentamob.com,REJECT,extended-matching,pre-matching
DOMAIN,service.yunxish.com,REJECT,extended-matching,pre-matching
