^https?:\/\/m5\.amap\.com\/ws\/feature\/preheat\/bootevent(?:\?|$) - reject-dict
^https?:\/\/m5\.amap\.com\/ws\/shield\/dsp\/app\/startup\/init(?:\?|$) - reject-dict
^https?:\/\/m5\.amap\.com\/ws\/valueadded\/alimama\/splash_screen(?:\?|$) - reject-dict
^https?:\/\/oss\.amap\.com\/ws\/banner\/lists\/\? - reject-dict
^https?:\/\/m5\.amap\.com\/ws\/shield\/search_poi\/tips_adv\? - reject-dict

# ===== 后续增强：爱思全能版开屏 =====
^https?:\/\/list-app-m\.i4\.cn\/getopfstadinfo\.xhtml - reject-dict
^https?:\/\/list-app-m\.i4\.cn\/adclickcb\.xhtml - reject
^https?:\/\/d\.image\.i4\.cn\/adInfo\/ - reject-200

# ===== 微博 / 微博国际版 =====
^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?.*a=get_coopen_ads(?:&|$).* - reject
^https?:\/\/api\.weibo\.cn\/2\/ad\/weibointl(?:\?|$).* - reject
^https?:\/\/bootpreload\.uve\.weibo\.com\/v1\/ad\/preload$ - reject
^https?:\/\/api\.weibo\.cn\/2\/ad\/ - reject-dict
^https?:\/\/tqt\.weibo\.cn\/.*advert - reject
^https?:\/\/tqt\.weibo\.cn\/overall\/redirect\.php\?r=(tqt_sdkad|tqtad) - reject

# ===== 豆瓣 =====
^https?:\/\/webcast-open\.douyin\.com\/webcast\/openapi\/pangle\/setting\/.*package_name=com\.douban\.frodo.* - reject
^https?:\/\/api\.douban\.com\/b.*\/common_ads\?.* - reject-dict
^https?:\/\/api\.douban\.com\/v\d+\/app_ads\/.* - reject

# ===== 小宇宙：只保留开屏，不再拦 AI / 分类 / 搜索等正常功能 =====
