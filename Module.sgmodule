^https?:\/\/interface3\.music\.163\.com\/eapi\/ad\/loading\/current(?:\?.*)?$ - reject-dict
^https?:\/\/interface3\.music\.163\.com\/eapi\/ad\/iyunIds(?:\?.*)?$ - reject-dict


