[Body Rewrite]

# ===== 豆瓣 =====
# feed 中常见广告数组
^https?:\/\/api\.douban\.com\/.* response-body-replace-regex "\"ad_info\":\{.*?\}," ""
^https?:\/\/api\.douban\.com\/.* response-body-replace-regex "\"ads\":\[.*?\]" "\"ads\":[]"
^https?:\/\/api\.douban\.com\/.* response-body-replace-regex "\"splash_ad\":\{.*?\}" "\"splash_ad\":{}"

# ===== 小宇宙 =====
^https?:\/\/api\.xiaoyuzhoufm\.com\/.* response-body-replace-regex "\"adInfo\":\{.*?\}," ""
^https?:\/\/api\.xiaoyuzhoufm\.com\/.* response-body-replace-regex "\"ads\":\[.*?\]" "\"ads\":[]"

# ===== 微信公众号 =====
^https?:\/\/mp\.weixin\.qq\.com\/s\?.* response-body-replace-regex "<div[^>]+class=\"[^\"]*(?:ad|advert)[^\"]*\"[^>]*>[\s\S]*?<\/div>" ""
^https?:\/\/mp\.weixin\.qq\.com\/s\?.* response-body-replace-regex "<section[^>]+class=\"[^\"]*(?:ad|advert)[^\"]*\"[^>]*>[\s\S]*?<\/section>" ""
^https?:\/\/mp\.weixin\.qq\.com\/s\?.* response-body-replace-regex "<div[^>]+id=\"js_bottom_ad_area\"[\s\S]*?<\/div>" ""

# ===== B站 =====
^https?:\/\/app\.bilibili\.com\/x\/v2\/feed\/index response-body-replace-regex "\{[^\{\}]*\"card_type\":\"ad\"[^\{\}]*\},?" ""
^https?:\/\/app\.bilibili\.com\/x\/v2\/feed\/index response-body-replace-regex "\{[^\{\}]*\"ad_info\"[^\{\}]*\},?" ""
^https?:\/\/app\.bilibili\.com\/x\/v2\/feed\/index response-body-replace-regex "\{[^\{\}]*\"ad_cb\"[^\{\}]*\},?" ""

# ===== 百度网盘 =====
^https?:\/\/pan\.baidu\.com\/.* response-body-replace-regex "\"advertise\":\{.*?\}," ""
^https?:\/\/pan\.baidu\.com\/.* response-body-replace-regex "\"ads\":\[.*?\]" "\"ads\":[]"

# ===== 航旅纵横 =====
^https?:\/\/home\.umetrip\.com\/gateway\/api\/umetrip\/native response-body-replace-regex "\"advertise\":\[.*?\]" "\"advertise\":[]"
^https?:\/\/home\.umetrip\.com\/gateway\/api\/umetrip\/native response-body-replace-regex "\"ads\":\[.*?\]" "\"ads\":[]"

